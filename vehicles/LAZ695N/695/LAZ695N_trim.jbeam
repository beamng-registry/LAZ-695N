"LAZ695N_engdoorhandle_black": {
    "information":{
        "authors":"Bagusik",
        "name":"Black Handle", 
    }
       "slotType" : "LAZ695N_engdoorhandle", 
       "slots": [
           ["type", "default", "description"],
           ["LAZ695N_handle_lettering", "", "Lettering"],
       ],
       "flexbodies": [
		["mesh", "[group]:", "nonFlexMaterials"],
		["LAZ695N_engdoor_handle_black", ["LAZ695N_enginedoor"]],
         	{"deformGroup":"taillight_R_break", "deformMaterialBase":"LAZ695N_glass", "deformMaterialDamaged":"LAZ695N_lights_dmg"},
         	["LAZ695N_handlelight_R", ["LAZ695N_enginedoor"],[]{"pos":{"x":0.0, "y":0.0, "z":0.0}, "deformSound":"event:>Destruction>Vehicle>Glass>glassbreaksound2", "deformVolume":0.5}],
        	{"deformGroup":"taillight_L_break", "deformMaterialBase":"LAZ695N_glass", "deformMaterialDamaged":"LAZ695N_lights_dmg"},
        	["LAZ695N_handlelight_L", ["LAZ695N_enginedoor"],[]{"pos":{"x":0.0, "y":0.0, "z":0.0}, "deformSound":"event:>Destruction>Vehicle>Glass>glassbreaksound2", "deformVolume":0.5}],
        	{"deformGroup":""},
	],
    "props": [
        ["func"      , "mesh"              , "idRef:", "idX:", "idY:"            , "baseRotation"        , "rotation"                 , "translation"        , "min", "max", "offset", "multiplier"],
        //license plate lights
        {
            "lightInnerAngle":80,
            "lightOuterAngle":170,
            "lightRange":0.45,
            "lightColor":{"r":255, "g":195, "b":070, "a":255}
            "lightAttenuation":{"x":0, "y":1, "z":1},
            "lightCastShadows":false,
            "cookieName":"art/special/BNG_light_cookie_headlight.dds"
        },
        ["lowhighbeam", "SPOTLIGHT", "ed3", "ed6", "ed5", {"x":-55, "y":30, "z":280}, {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0}, 0, 0, 0, 1, {"baseTranslation":{"x":0.616, "y":0.05, "z":0.050},"flareScale":0.0005,"lightBrightness":1.2,"deformGroup":"taillight_L_break"}],
        ["lowhighbeam", "SPOTLIGHT", "ed5", "ed4", "ed3", {"x":-55, "y":30, "z":280}, {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0}, 0, 0, 0, 1, {"baseTranslation":{"x":0.616, "y":0.05, "z":-0.050},"flareScale":0.0005,"lightBrightness":1.2,"deformGroup":"taillight_R_break"}],
     ],
 },
