        ["lowhighbeam"    , "SPOTLIGHT"        , "z508ll", "z509ll", "z509l", {"x":180, "y":0, "z":0}, {"x":0, "y":0, "z":0}  , {"x":0, "y":0, "z":0}, 0, 0, 0, 1, {"baseTranslation":{"x":0.25, "y":0.14, "z":-0.09},"deformGroup":"LAZ695N_backlight_L_deform"}],
