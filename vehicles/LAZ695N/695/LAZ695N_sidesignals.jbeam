        ["lowhighbeam"    , "SPOTLIGHT"        , "z500ll", "z501ll", "z501l", {"x":180, "y":0, "z":0}, {"x":0, "y":0, "z":0}  , {"x":0, "y":0, "z":0}, 0, 0, 0, 1, {"baseTranslation":{"x":0.25, "y":0.08, "z":-0.07},"deformGroup":"LAZ695N_window_2_L_break"}],
