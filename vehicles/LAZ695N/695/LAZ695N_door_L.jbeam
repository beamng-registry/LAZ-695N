{
"LAZ695N_door_L":{
	"information":{
	"authors":"Bagusik",
	"name":"Driver Door (Late Window)",
	},
    "slotType":"LAZ695N_door_L",
    "flexbodies":[
        ["mesh", "[group]:", "nonFlexMaterials"],
        ["LAZ695N_door_L", ["LAZ695N_driver_door"]], 
        {"deformGroup":"driverdoor_glass_break", "deformMaterialBase":"LAZ695N_glass", "deformMaterialDamaged":"LAZ695N_glass_dmg"},
        ["LAZ695N_doorglass_L", ["LAZ695N_driver_door"],[]{"deformSound":"event:>Destruction>Vehicle>Glass>glassbreaksound4", "deformVolume":0.5}],
        ["LAZ695N_doorglassint_L", ["LAZ695N_driver_door"],[]{"deformSound":"event:>Destruction>Vehicle>Glass>glassbreaksound4", "deformVolume":0.5}],
        {"deformGroup":"", "deformMaterialBase":"", "deformMaterialDamagdrd":""},
    ],
    "controller": [
        ["fileName"],
        ["advancedCouplerControl", {"name":"DoorDriverCoupler"}],
    ]
    "DoorDriverCoupler":{
        "groupType": "autoCoupling",
        "couplerNodes":[
            ["cid1",    "cid2",     "autoCouplingStrength",    "autoCouplingRadius",   "autoCouplingLockRadius",   "autoCouplingSpedrd"]
            ["z201l",    "latch_drd",    45000,                  0.05,                   0.010,                      0.2]
        ]
        "attachSoundVolume":3,
        "detachSoundVolume":3,
        "soundNode":["z301ll"]
        "attachSoundEvent": "event:>Vehicle>Latches>Door>80s_03_close",
        "detachSoundEvent": "event:>Vehicle>Latches>Door>80s_03_open",
        "breakSoundEvent":""
        "openForceMagnitude": 50,
        "openForceDuration": 0.1,
        "closeForceMagnitude": 200,
        "closeForceDuration": 2.9
    }
    "triggers":[
        ["id", "label", "idRef:", "idX:", "idY:", "type", "size", "baseRotation", "rotation", "translation", "baseTranslation"],
        ["door_Driver_int", "", "drd5","drd2","drd4", "box", {"x":0.13, "y":0.025, "z":0.03}, {"x":0, "y":13, "z":0}, {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0}, {"x":0.615, "y":0.054, "z":0.025}],
        ["door_Driver_ext", "", "drd5","drd2","drd4", "box", {"x":0.13, "y":0.025, "z":0.03}, {"x":0, "y":10, "z":0}, {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0}, {"x":0.64, "y":0.06, "z":-0.025}],
    ],
    "triggerEventLinks":[
        ["triggerId:triggers", "action", "targetEventId:events"],
        ["door_Driver_int", "action0", "doorLatch_Driver"],
        ["door_Driver_ext", "action0", "doorLatch_Driver"],
    ],
    "events":[
        ["id", "title", "desc"],
        ["doorLatch_Driver", "", "", {"onUp":"controller.getControllerSafe('DoorDriverCoupler').toggleGroup()"}],
    ],
	"nodes":[
	["id", "posX", "posY", "posZ"],
        {"frictionCoef":0.5},
        {"nodeMaterial":"|NM_METAL"},
        {"nodeWeight":2},
	{"group":"LAZ695N_driver_door"},
        {"collision":true},
        {"selfCollision":false},
	["drd1", 1.23929, -2.92608, 2.44214],
	["drd2", 1.29473, -2.92608, 1.44778],
	["drd3", 1.29473, -2.92608, 0.92153],
	["drd4", 1.23929, -3.70314, 2.44214],
	["drd5", 1.29473, -3.70314, 1.44778],
	["drd6", 1.29473, -3.70314, 0.92153],
	{"group":""},
	["drdm1", 1.26340, -3.71995, 2.00505],
