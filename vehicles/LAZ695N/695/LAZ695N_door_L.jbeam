        //latch
	["latch_drd", 0.52224, -2.87191, 0.95000 {"couplerTag":"doorLatch_Driver","couplerLock":true,"couplerStrength":45000,"couplerRadius":1.35,"couplerStartRadius":0.5,"couplerLockRadius":0.1,"couplerLatchSpeed":0.8, "breakGroup":""}],
	["drdr1", 1.07068, -3.31528, 1.60382],
	{"group":""},
    ],
	"beams":[
		["id1:", "id2:"],
        	{"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1, "beamShortBound":1},
        	{"deformLimitExpansion":1.1},
        	{"beamSpring":2501000,"beamDamp":200},
        	{"beamDeform":20000,"beamStrength":"FLT_MAX"},
        	{"deformGroup":"driverdoor_glass_break","deformationTriggerRatio":0.005},
		["drd1", "drd2"],
		["drd2", "drd3"],
		["drd4", "drd5"],
		["drd5", "drd6"],
		["drd6", "drd3"],
		["drd5", "drd2"],
		["drd4", "drd1"],
		["drd1", "drd5"],
		["drd2", "drd4"],
		["drd2", "drd6"],
		["drd3", "drd5"],
		["drd4", "drd6"],
		["drd1", "drd3"],
		//rigidfires
		["drdr1", "drd1"],
		["drdr1", "drd4"],
		["drdr1", "drd5"],
		["drdr1", "drd2"],
		["drdr1", "drd3"],
		["drdr1", "drd6"],
		["drdr1", "drdm2"],
		["drdr1", "drdm1"],
        	{"deformGroup":""},
        	{"breakGroup":""},
		//hinges
		["drd5", "drdm1"],
		["drdm1", "drd4"],
		["drdm1", "drd1"],
		["drdm1", "drd2"],
		["drdm2", "drd5"],
		["drdm2", "drd6"],
		["drdm2", "drd2"],
		["drdm2", "drd3"],
		//latch mount
        	{"beamDeform":10000},
		["latch_drd", "drd1"],
		["latch_drd", "drd4"],
		["latch_drd", "drd5"],
		["latch_drd", "drd2"],
		["latch_drd", "drd3"],
		["latch_drd", "drd6"],


		//body attach
        	{"beamDeform":50000,"beamStrength":90000},
        	{"breakGroup":"driverdoor_hinge_U"},
		["drdm1", "z500ll"],
		["drdm1", "z500all"],
		["drdm1", "z400ll"],
		["drdm1", "z401ll"],
		["drdm1", "z501all"],
		["drdm1", "z501ll"],
        	{"breakGroup":"driverdoor_hinge_L"},
		["drdm2", "z400ll"],
		["drdm2", "z301ell"],
		["drdm2", "z201ell"],
		["drdm2", "z401ll"],
		["drdm2", "z301ll"],
		["drdm2", "z201ll"],
        	{"breakGroup":""},

        	//pop door open front
        	{"beamSpring":100,"beamDamp":45},
        	{"beamDeform":5000,"beamStrength":60000},
        	{"beamPrecompression":2.0},
        	["z201l", "drd2",{"breakGroup":"driverdoor_hinge_L", "beamPrecompressionTime":0.2}],
        	["z201l", "drd1",{"breakGroup":"driverdoor_hinge_U", "beamPrecompressionTime":0.2}],
        	{"breakGroup":""},
		//limiter
        	{"beamPrecompression":1, "beamType":"|BOUNDdrd", "beamLongBound":0.01, "beamShortBound":0},
        	{"beamDeform":3000,"beamStrength":10000},
        	{"beamSpring":0,"beamDamp":400},
        	{"beamLimitSpring":101000,"beamLimitDamp":100},
        	["z205ll", "drd2",{"breakGroup":"driverdoor_hinge_L"}],
        	["z205l", "drd1",{"breakGroup":"driverdoor_hinge_U"}],
        	{"beamPrecompression":1, "beamType":"|NORMAL"},
        	{"breakGroup":""},
		],
