{
"LAZ695N_wheel_F": {
    "information":{
        "authors":"BeamNG",
        "name":"LAZ 695N Front Wheels",
        "value":400,
    }
    "flexbodies": [
         ["mesh", "[group]:", "nonFlexMaterials"],
         //wheels
         ["LAZ695N_rim_F", ["wheel_FR","wheelhub_FR"], [], {"pos":{"x":-1.0654, "y":-2.27956, "z":0.45}, "rot":{"x":0, "y":0, "z":180}, "scale":{"x":1, "y":1, "z":1}}],
         ["LAZ695N_rim_F", ["wheel_FL","wheelhub_FL"], [], {"pos":{"x": 1.0654, "y":-2.27956, "z":0.45}, "rot":{"x":0, "y":0, "z":0}, "scale":{"x":1, "y":1, "z":1}}],
     ],
    "slotType" : "LAZ695N_wheel_F",
    "slots": [
        ["type", "default", "description"]
        ["LAZ695N_tire_F","LAZ695N_tire_F", "Front Tires"],
        ["LAZ695N_hubcaps_F","", "Front Hubcaps"],
        ["LAZ695N_whitestrips_F","", "Front Stripes"],
    ],
    "beams": [
          ["id1:", "id2:"],
          //--FRONT WHEELS--
          {"beamSpring":2501000,"beamDamp":25},
          {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1, "beamShortBound":1},
          {"beamDeform":200000,"beamStrength":"FLT_MAX"},
          ["fh1r","fh1rr"],
          ["fh1l","fh1ll"],
          {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1, "beamShortBound":1},
    ],
    "pressureWheels": [
            ["name","hubGroup","group","node1:","node2:","nodeS","nodeArm:","wheelDir"],
            {"enableTireLbeams":true,"disableMeshBreaking":false,"disableHubMeshBreaking":false},

            //general settings
            {"hubRadius":0.30},
            {"wheelOffset":-0.08},
            {"hubWidth":0.255},
            {"numRays":16},
            {"brakeSpring":150},//define higher value than hubs

            //hub options
            {"hubTreadBeamSpring":3001000, "hubTreadBeamDamp":25},
            {"hubPeripheryBeamSpring":3001000, "hubPeripheryBeamDamp":25},
            {"hubSideBeamSpring":4001000, "hubSideBeamDamp":25},
            {"hubBeamDeform":170000, "hubBeamStrength":470000},
            {"hubNodeWeight":1.25},
            {"hubNodeMaterial":"|NM_METAL","hasTire":false},
            {"hubFrictionCoef":0.5},
    ],
	
},
