        ["frontDoors", "event:>Vehicle>Pneumatics>Door_Open", "event:>Vehicle>Pneumatics>Door_Close", 0.35, 0.35, "st3rr"],
        ["rearDoors", "event:>Vehicle>Pneumatics>Door_Open", "event:>Vehicle>Pneumatics>Door_Close", 0.35, 0.35, "st11rr"],
    ],
    "airbrakes": {
