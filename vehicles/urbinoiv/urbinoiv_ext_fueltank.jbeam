    "information":{
        "authors":"BeamNG",
        "name":"Fuel Tank",
        "value":600,
    },
    "slotType" : "urbinoiv_ext_fueltank",
    "flexbodies": [
         ["mesh", "[group]:", "nonFlexMaterials"],
