         {"nodeWeight":0.5},
         {"nodeMaterial":"|NM_PLASTIC"},
         {"engineGroup":["fuel"]}
         {"chemEnergy":50,"burnRate":1.2,"flashPoint":220,"vaporPoint":95,"specHeat":0.03,"selfIgnitionCoef":0.2,"smokePoint":220,"containerBeam":"fuelTank"},
		 ["ft1", 0.00, 8.125, 0.50],
