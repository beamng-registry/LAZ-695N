          {"disableMeshBreaking":true,"disableTriangleBreaking":true},
          //connect fuel particles to tank
          {"beamSpring":100000,"beamDamp":200},
          {"breakGroup":""},
          {"breakGroupType":1},
          {"deformLimitExpansion":""},
