        "urbinoiv_door_light":{"simpleFunction":{"doorLever":0.75}, "off":"urbinoiv_lights", "on":"urbinoiv_light_on"},
        "urbinoiv_gauges":{"simpleFunction":{"lowhighbeam":0.6}, "off":"urbinoiv_gauges", "on":"urbinoiv_gauges_on"},
        "urbinoiv_signals_int":{"simpleFunction":{"signal_R":0.75,"signal_L":0.75}, "off":"urbinoiv_signals_int_off", "on":"urbinoiv_signals_int_on"},
        "urbinoiv_highbeam_int":{"simpleFunction":{"highbeam":0.75}, "off":"urbinoiv_signals_int_off", "on":"urbinoiv_signals_int_on"},
