        "urbinoiv_oilpressure_int":{"simpleFunction":{"oilpressure":0.75}, "off":"urbinoiv_signals_int_off", "on":"urbinoiv_signals_int_on"},
        "urbinoiv_dooropen_int":{"simpleFunction":{"doorLever":0.75}, "off":"urbinoiv_signals_int_off", "on":"urbinoiv_signals_int_on"},
        "urbinoiv_doorclose_int":{"simpleFunction":{"doorLever":0.75}, "off":"urbinoiv_signals_int_off", "on":"urbinoiv_signals_int_on"},
        "urbinoiv_wypadek_int":{"simpleFunction":{"hazard":0.75}, "off":"urbinoiv_signals_int_off", "on":"urbinoiv_signals_int_on"},

        "signal_L":           {"simpleFunction":"signal_L",      "off":"invis", "on":"decals_gauges"},
        "signal_R":           {"simpleFunction":"signal_R",      "off":"invis", "on":"decals_gauges"},
        "checkengine":        {"simpleFunction":"checkengine",   "off":"invis", "on":"decals_gauges"},
