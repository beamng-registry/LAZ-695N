        "urbinoiv_highbeam":{"simpleFunction":{"highbeam":1}, "off":"urbinoiv_lights", "on":"urbinoiv_light_on", "on_intense":"urbinoiv_light_on"},
        "urbinoiv_reverse":{"simpleFunction":{"reverse":0.75}, "off":"urbinoiv_lights", "on":"urbinoiv_light_on"},
