    "glowMap":{
        "urbinoiv_signal_L":{"simpleFunction":{"signal_L":0.75}, "off":"urbinoiv_lights", "on":"urbinoiv_light_on", "on_intense":"urbinoiv_light_on"},
        "urbinoiv_signal_R":{"simpleFunction":{"signal_R":0.75}, "off":"urbinoiv_lights", "on":"urbinoiv_light_on", "on_intense":"urbinoiv_light_on"},
        "urbinoiv_signal_RL":{"simpleFunction":{"lowhighbeam":0.55,"brake":1,"signal_L":0.75}, "off":"urbinoiv_lights", "on":"urbinoiv_rede", "on_intense":"urbinoiv_pov"},
        "urbinoiv_signal_RR":{"simpleFunction":{"lowhighbeam":0.55,"brake":1,"signal_R":0.75}, "off":"urbinoiv_lights", "on":"urbinoiv_rede", "on_intense":"urbinoiv_pov"},
        "urbinoiv_running":{"simpleFunction":{"running":1,"lowhighbeam":0.55}, "off":"urbinoiv_lights", "on":"urbinoiv_light_on"},
        "urbinoiv_runninglight":{"simpleFunction":{"running":1,"lowhighbeam":0.55}, "off":"urbinoiv_lights", "on":"urbinoiv_light_on"},
